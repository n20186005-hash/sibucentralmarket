          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 17V7h4a3 3 0 0 1 0 6H9"/></svg>
          Maklumat Parkir Kenderaan
        </span>
        <h2 class="section-title mt-3">Di Mana Hendak Letak Kereta / Motosikal?</h2>
        <p class="mt-3 text-rajang-700 leading-prose">
          Parkir di Jalan Channel adalah terhad dan cepat penuh pada waktu
          pagi. Berikut adalah {PARKING.length} pilihan tempat parkir terbaik
          berhampiran Pasar Sentral Sibu untuk rujukan anda.
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        {PARKING.map((p) => (
          <article class="card p-5 md:p-6 flex flex-col gap-4">
            <div class="flex items-start gap-4">
              <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-teak-200 text-teak-700">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 17V7h4a3 3 0 0 1 0 6H9"/></svg>
              </span>
              <div class="min-w-0 flex-1">
                <h3 class="font-display text-lg font-bold text-rajang-900 leading-snug">
                  {p.name}
                </h3>
                <p class="text-sm text-rajang-600 mt-0.5">Jarak dari pasar: {p.distance}</p>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-3 rounded-xl bg-swan-50 p-4 text-sm">
              <div>
                <p class="text-xs uppercase tracking-wider text-rajang-500 font-semibold">Kadar Bayaran</p>
                <p class="mt-1 font-bold text-rajang-900">{p.rate}</p>
              </div>
              <div>
                <p class="text-xs uppercase tracking-wider text-rajang-500 font-semibold">Kapasiti</p>
                <p class="mt-1 font-bold text-rajang-900">{p.capacity}</p>
              </div>
            </div>
            <p class="text-sm text-rajang-700 leading-relaxed">{p.notes}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 8: PENGANGKUTAN TERPERINCI -->
  <section id="pengangkutan" class="scroll-mt-24">
    <div class="container py-16 md:py-20">
      <div class="max-w-3xl mb-10 md:mb-12">
        <span class="section-eyebrow">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 17h14M5 17a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2M5 17l-1 3M19 17l1 3"/></svg>
          Pengangkutan Terperinci
        </span>
        <h2 class="section-title mt-3">7 Cara Ke Pasar Sentral Sibu</h2>
        <p class="mt-3 text-rajang-700 leading-prose">
          Dari Lapangan Terbang Sibu (SBW), stesen bas, Terminal Bot Ekspres,
          dan sekitar bandar. Panduan langkah demi langkah lengkap termasuk
          anggaran kos dan petua tempatan yang sebenarnya.
        </p>
      </div>

      <div class="space-y-5">
        {TRANSPORT.map((t, idx) => (
          <details
            class={`card overflow-hidden transition ${idx === 0 ? 'open' : ''}`}
            {...(idx === 0 ? { open: true } : {})}
          >
            <summary class="list-none cursor-pointer">
              <div class="flex flex-wrap items-center gap-4 px-5 py-5 md:px-6 md:py-6 hover:bg-swan-50 transition pr-14 relative">
                <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-rajang-100 text-rajang-700 text-lg">
                  {modeLabels[t.mode]?.icon ?? '📍'}
                </span>
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="chip">{modeLabels[t.mode]?.label ?? t.mode}</span>
                    <span class="inline-flex items-center gap-1 text-xs font-semibold text-teak-700">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                      {t.duration}
                    </span>
                  </div>
                  <h3 class="mt-1.5 font-display text-lg md:text-xl font-bold text-rajang-900 leading-snug pr-4">
                    {t.title}
                  </h3>
                  <p class="mt-1 text-sm text-rajang-600 font-semibold">Anggaran kos: {t.cost}</p>
                </div>
                <span class="absolute right-5 top-1/2 -translate-y-1/2 inline-flex h-9 w-9 items-center justify-center rounded-full bg-rajang-50 text-rajang-600 group-open:rotate-180 transition open:rotate-180">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </span>
              </div>
            </summary>
            <div class="px-5 pb-6 md:px-6 md:pb-7 md:pl-[5.25rem] pl-[4.25rem] grid lg:grid-cols-5 gap-6">
              <div class="lg:col-span-3">
                <p class="text-xs font-semibold uppercase tracking-wider text-rajang-500 mb-3">Langkah-langkah</p>
                <ol class="space-y-3 text-sm text-rajang-800">
                  {t.steps.map((step, i) => (
                    <li class="flex gap-3">
                      <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-rajang-900 text-white text-xs font-bold">
                        {i + 1}
                      </span>
                      <span class="leading-relaxed">{step}</span>
                    </li>
