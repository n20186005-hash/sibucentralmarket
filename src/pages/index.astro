              </div>
              <div class="lg:col-span-2">
                <p class="text-xs font-semibold uppercase tracking-wider text-teak-600 mb-2">💡 Petua Tempatan</p>
                <div class="rounded-xl bg-teak-50 border border-teak-100 p-4 text-sm text-teak-900 leading-relaxed">
                  {t.tips}
                </div>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

