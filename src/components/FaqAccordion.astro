---
import { FAQS } from '@/consts';

const site = Astro.site;
const faqPage = site ? new URL('/#faq', site).toString() : undefined;
---

<aside class="hidden" aria-hidden="true">
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      '@id': faqPage ? `${faqPage}#faqpage` : undefined,
      mainEntity: FAQS.map((f, idx) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: f.a,
        },
        position: idx + 1,
      })),
    })}
  ></script>
</aside>

<section id="faq" class="scroll-mt-24">
  <div class="container py-16 md:py-20">
    <div class="max-w-3xl mb-10 md:mb-12">
      <span class="section-eyebrow">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
        Soalan Lazim
      </span>
      <h2 class="section-title mt-3">FAQ · 17 Soalan yang sering ditanya</h2>
      <p class="mt-3 text-rajang-700 leading-prose">
        Jawapan lengkap untuk persoalan paling kerap diajukan oleh pelawat
        sebelum dan semasa melawat Pasar Sentral Sibu — dari waktu operasi,
        cara tawar harga, coklat makanan wajib cuba, petua gambar tradisi
        ayam-surat khabar, hinggalah musim durian Sarawak.
      </p>
    </div>

    <div class="grid gap-3">
      {FAQS.map((f, i) => (
        <details
          class={`group card p-0 overflow-hidden transition ${i === 0 ? 'open' : ''}`}
          {...(i === 0 ? { open: true } : {})}
        >
          <summary class="flex cursor-pointer list-none items-start gap-4 px-5 py-4 md:px-6 md:py-5 hover:bg-swan-50 transition pr-14 relative">
            <span class="mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-rajang-100 text-rajang-700 text-xs font-bold">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="font-semibold text-rajang-900 leading-snug">{f.q}</span>
            <span class="absolute right-5 top-1/2 -translate-y-1/2 inline-flex h-8 w-8 items-center justify-center rounded-full bg-rajang-50 text-rajang-600 group-open:rotate-180 transition">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </span>
          </summary>
          <div class="px-5 pb-5 md:px-6 md:pb-6 pl-[4.25rem] md:pl-[4.75rem] text-sm text-rajang-700 leading-relaxed">
            {f.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
