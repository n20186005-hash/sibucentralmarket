---
import { SITE } from '@/consts';
import { LOCALES, LOCALE_META, localePath, type Locale } from '@/i18n/config';
import { UI } from '@/i18n/ui';

type Props = { locale: Locale };
const { locale } = Astro.props;

const nav = UI[locale].nav;
const home = localePath(locale);
---

<header id="atas" class="sticky top-0 z-40 border-b border-rajang-100/60 bg-swan-50/85 backdrop-blur">
  <div class="container flex h-16 items-center justify-between gap-4">
    <a href={`${home}#atas`} class="flex items-center gap-3 group" aria-label={SITE.nameByLocale[locale]}>
      <img src="/logo.svg" alt="" width="180" height="60" class="h-10 w-auto group-hover:scale-[1.02] transition" />
    </a>
    <nav class="hidden xl:block" aria-label={UI[locale].labels.bahagianPasar}>
      <ul class="flex flex-wrap items-center gap-x-1 gap-y-2 text-sm font-medium">
        {nav.map((s) => (
          <li>
            <a
              href={`#${s.id}`}
              class="rounded-lg px-2.5 py-1.5 text-rajang-700 hover:bg-rajang-100 hover:text-rajang-900 transition"
            >
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="flex items-center gap-2">
      <ul class="flex items-center gap-1" aria-label="Language">
        {LOCALES.map((l) => (
          <li>
            <a
              href={localePath(l)}
              hreflang={LOCALE_META[l].hreflang}
              rel="alternate"
              aria-current={l === locale ? 'page' : undefined}
              class={`rounded-lg px-2.5 py-1.5 text-xs font-bold tracking-wide transition ${
                l === locale
                  ? 'bg-rajang-900 text-white'
                  : 'text-rajang-700 hover:bg-rajang-100 hover:text-rajang-900'
              }`}
            >
              {LOCALE_META[l].short}
            </a>
          </li>
        ))}
      </ul>
      <a href="#tiket" class="btn-primary hidden sm:inline-flex">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M13 5v2"/><path d="M13 17v2"/><path d="M13 11v2"/></svg>
        {UI[locale].ctaButton}
      </a>
      <details class="xl:hidden group relative">
        <summary class="flex h-10 w-10 items-center justify-center rounded-lg text-rajang-700 hover:bg-rajang-100 list-none cursor-pointer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        </summary>
        <div class="absolute right-0 mt-2 w-64 rounded-2xl border border-rajang-100 bg-white p-3 shadow-card z-50">
          <ul class="flex flex-col gap-0.5 text-sm font-medium">
            {nav.map((s) => (
              <li>
                <a href={`#${s.id}`} class="block rounded-lg px-3 py-2 text-rajang-800 hover:bg-rajang-50">
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </details>
    </div>
  </div>
</header>
