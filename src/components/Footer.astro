---
import { SITE } from '@/consts';
import { LOCALE_META, type Locale } from '@/i18n/config';
import { UI } from '@/i18n/ui';

type Props = { locale: Locale };
const { locale } = Astro.props;

const ui = UI[locale];
const name = SITE.nameByLocale[locale];
const year = new Date().getFullYear();
const quickLinks = ui.nav.filter((n) =>
  ['bahagian', 'galeri', 'pengangkutan', 'parkir', 'makanan', 'tempat-menarik', 'peta', 'faq'].includes(n.id)
);
---

<footer class="border-t border-rajang-100/70 bg-rajang-950 text-rajang-100 pattern-rajang">
  <div class="container py-12 md:py-16 grid gap-10 md:grid-cols-12 items-start">
    <div class="md:col-span-5">
      <div class="flex items-center gap-3 mb-4">
        <img src="/favicon.svg" alt="" width="40" height="40" />
        <span class="font-display text-xl font-bold text-white">{name}</span>
      </div>
      <p class="text-sm leading-relaxed text-rajang-200 max-w-md">{ui.footer.about}</p>
      <div class="mt-5 text-xs text-rajang-400 space-y-1">
        <p>📍 {ui.footer.addressLabel}: {SITE.address}</p>
        <p>☎ {SITE.telephone} · {LOCALE_META[locale].label}</p>
      </div>
    </div>
    <div class="md:col-span-4">
      <h4 class="font-display text-base font-bold text-white mb-3">{ui.footer.quickTitle}</h4>
      <ul class="text-sm grid grid-cols-2 gap-2 text-rajang-200">
        {quickLinks.map((l) => (
          <li><a href={`#${l.id}`} class="hover:text-white underline-offset-2 hover:underline">{l.label}</a></li>
        ))}
        <li><a href="#sumber" class="hover:text-white underline-offset-2 hover:underline">{ui.labels.sumberRasmi}</a></li>
      </ul>
    </div>
    <div class="md:col-span-3">
      <h4 class="font-display text-base font-bold text-white mb-3">{ui.labels.pengiktirafan}</h4>
      <div class="rounded-2xl border border-rajang-800 bg-rajang-900/60 p-4 text-xs leading-relaxed text-rajang-300 space-y-2">
        <p class="font-semibold text-rajang-100">{ui.footer.disclaimerTitle}</p>
        {ui.footer.disclaimer.map((d) => <p>{d}</p>)}
      </div>
    </div>
  </div>
  <div class="border-t border-rajang-800/70">
    <div class="container py-5 flex flex-col md:flex-row items-center justify-between gap-3 text-xs text-rajang-400">
      <p>© {year} {name}. {ui.footer.copyright}</p>
      <a href="#atas" class="inline-flex items-center gap-1.5 hover:text-rajang-100 transition">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6"/></svg>
        {ui.footer.backToTop}
      </a>
    </div>
  </div>
</footer>
