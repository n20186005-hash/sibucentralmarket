---
import '@/styles/global.css';
import BaseHead from '@/components/BaseHead.astro';
import GA4 from '@/components/GA4.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE } from '@/consts';
import { LOCALE_META, type Locale } from '@/i18n/config';
import { UI } from '@/i18n/ui';
import { buildFaqSchema, buildMarketSchema, buildSiteSchema } from '@/lib/schema';

type Props = {
  locale: Locale;
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
};

const {
  locale,
  title = UI[locale].meta.title,
  description = UI[locale].meta.description,
  image = SITE.ogImage,
  canonical = '/',
} = Astro.props;

const marketLd = buildMarketSchema(locale);
const siteLd = buildSiteSchema(locale);
const faqLd = buildFaqSchema(locale);
---

<!doctype html>
<html lang={LOCALE_META[locale].htmlLang}>
  <head>
    <BaseHead locale={locale} title={title} description={description} image={image} canonical={canonical} />
    <GA4 />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(siteLd)}></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(marketLd)}></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#hero" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-4 focus:rounded-lg focus:bg-rajang-900 focus:px-4 focus:py-2 focus:text-white">
      {UI[locale].ctaButton}
    </a>
    <Header locale={locale} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
